# Copy to `.env` and fill in. Every service below has a free tier; no credit card needed.
# Nothing in Phases 0-2 needs a key - only DATABASE_URL (the docker-compose default works).

# ---- API runtime -----------------------------------------------------------
ENV=local                       # local | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---- Database ----------------------------------------------------------------
# Local: docker compose up -d db. Deployed: Neon connection string (sslmode=require is handled).
DATABASE_URL=postgresql://support:support@localhost:55432/support

# ---- LLM providers ------------------------------------------------------------
# Google AI Studio -> "Get API key": https://aistudio.google.com
GEMINI_API_KEY=
# Model ids are config: confirm the current free models in AI Studio before relying on these.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-flash-lite
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Groq (fallback when Gemini rate-limits): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- RAG (local embeddings, no key) -------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- Protection / demo ----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=20
CHAOS_ENABLED=false             # true lets the UI inject tool/LLM failures for the demo

# ---- Frontend (apps/web) -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
