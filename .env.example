# Copy to `.env` and fill in. Every service below has a free tier; no credit card needed.

# ---- API runtime -----------------------------------------------------------
ENV=local                       # local | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---- Database ----------------------------------------------------------------
# Local: docker compose up -d db. Deployed: Neon connection string (sslmode=require is handled).
DATABASE_URL=postgresql://support:support@localhost:55432/support

# ---- LLM providers ------------------------------------------------------------
# At least one key is required for agent turns (everything else works without).
# Groq: https://console.groq.com -> API Keys
GROQ_API_KEY=
# Google AI Studio -> "Get API key": https://aistudio.google.com
# (some accounts/projects get "free tier is not available" - Groq alone is enough)
GEMINI_API_KEY=

# Ordered fallback chains of provider:model. Each model has its own free-tier quota (Groq:
# ~8k tokens/minute), so the router skips to the next one on 429s - or before them, from the
# rate-limit headers. Confirm current model ids in the provider console.
AGENT_LLM_CHAIN=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
JUDGE_LLM_CHAIN=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b
# With a working Gemini key, e.g.: AGENT_LLM_CHAIN=gemini:gemini-2.5-flash,groq:openai/gpt-oss-120b

# ---- Voice (same Groq key) -------------------------------------------------------
GROQ_STT_MODEL=whisper-large-v3-turbo
# Orpheus needs a one-time terms acceptance: console.groq.com/playground?model=canopylabs/orpheus-v1-english
# Until then the browser's own speech synthesis is used automatically.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

# ---- RAG (local embeddings, no key) -------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- Protection / demo ----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=20
CHAOS_ENABLED=false             # true accepts an X-Chaos header, e.g. "llm:rate_limit:once"
DEMO_MODE=true                  # exposes /api/demo/personas (fake customers + their verification details)

# ---- Frontend (apps/web) -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
